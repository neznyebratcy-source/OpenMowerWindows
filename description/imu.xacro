<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="imu">
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu"/>
        <origin xyz="${robot['imu']['chip']['offset'][0]} ${robot['imu']['chip']['offset'][1]} ${robot['imu']['chip']['offset'][2]}" rpy="0 0 0"/>
    </joint>

    <link name="imu">
    </link>

    <gazebo reference="imu">
        <sensor name="imu" type="imu">
            <gz_frame_id>imu</gz_frame_id>
            <!-- not possible to disable orientation via SDF, we will skip it during fusion-->
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <visualize>true</visualize>
            <topic>imu/data_raw</topic>

            <!-- Добавленный блок шума на основе BMI160 Datasheet -->
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <!-- BMI160 Gyro: 0.07 deg/s rms @ ODR 200Hz -> 0.0012 rad/s -->
                            <stddev>0.0012</stddev> 
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0012</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0012</stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <!-- BMI160 Accel: 1.8 mg rms @ ODR 200Hz -> 0.018 m/s^2 -->
                            <stddev>0.018</stddev> 
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.018</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.018</stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>

        </sensor>

        <material>Gazebo/Red</material>
    </gazebo>
</robot>
