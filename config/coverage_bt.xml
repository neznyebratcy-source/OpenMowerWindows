<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Plan once then follow to completion. Replanning every N seconds would
         restart the snake from the polygon boundary each time, pulling the robot
         back to the start before it can make net progress (infinite loop). -->
    <Sequence name="PlanOnceThenFollow">
      <ComputePathToPose goal="{goal}" path="{path}"
                         planner_id="CoveragePlanner"
                         error_code_id="{compute_path_error_code}"/>
      <FollowPath path="{path}" controller_id="FollowPath"
                  error_code_id="{follow_path_error_code}"/>
    </Sequence>
  </BehaviorTree>
</root>